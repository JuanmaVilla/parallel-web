# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# masters de las fotos del hero. Pesan 23 MB y no se sirven: lo que se publica
# son los webp de public/hero-cards/, que salen de scripts/convert-hero-cards.mjs.
/fotos

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# masters de audio. Pesan ~95 MB y no se sirven: lo que se publica son los
# mp3 de public/audio/, que salen de scripts/convert-audio.sh.
/Audios

# output de la auditoria (reporte + screenshots + logs). Se regenera con tools/audit.js
/parallel-studio-audit
